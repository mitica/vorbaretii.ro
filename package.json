{
  "name": "vorbaretii.ro",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir app --dir lib --dir scripts && yarn dup && yarn deadcode && yarn naming",
    "naming": "ts-node --project ./tsconfig.base.json ./scripts/check-naming.ts",
    "dup": "jscpd",
    "deadcode": "knip",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-ui": "ts-node --project ./tsconfig.base.json ./scripts/check-ui.ts",
    "test": "ts-node --project ./tsconfig.base.json ./scripts/test-games.ts && ts-node --project ./tsconfig.base.json ./scripts/test-articles.ts && ts-node --project ./tsconfig.base.json ./scripts/test-image-prompt.ts && ts-node --project ./tsconfig.base.json ./scripts/test-image-serving.ts && ts-node --project ./tsconfig.base.json ./scripts/test-article-audio.ts && ts-node --project ./tsconfig.base.json ./scripts/test-article-video.ts && ts-node --project ./tsconfig.base.json ./scripts/test-mascot.tsx && ts-node --project ./tsconfig.base.json ./scripts/test-game-audio.ts && ts-node --project ./tsconfig.base.json ./scripts/test-sting.ts && ts-node --project ./tsconfig.base.json ./scripts/test-podcast.ts",
    "generate-article-audio": "ts-node --project ./tsconfig.base.json ./scripts/generate-article-audio.ts",
    "try-voice": "ts-node --project ./tsconfig.base.json ./scripts/try-voice.ts",
    "generate-game-audio": "ts-node --project ./tsconfig.base.json ./scripts/generate-game-audio.ts",
    "validate-article": "ts-node --project ./tsconfig.base.json ./scripts/validate-article.ts",
    "generate-article-image": "ts-node --project ./tsconfig.base.json ./scripts/generate-article-image.ts",
    "generate-article-video": "ts-node --project ./tsconfig.base.json ./scripts/generate-article-video.ts",
    "generate-og": "ts-node --project ./tsconfig.base.json ./scripts/generate-og.ts",
    "generate-podcast-cover": "ts-node --project ./tsconfig.base.json ./scripts/generate-podcast-cover.ts",
    "generate-sting": "ts-node --project ./tsconfig.base.json ./scripts/generate-sting.ts",
    "no-cache": "rm -rf .next/cache/fetch-cache",
    "generate-icons": "ts-node --project ./tsconfig.base.json ./scripts/generate-icons.ts",
    "compress-images": "ts-node --project ./tsconfig.base.json ./scripts/compress-images.ts"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "dotenv": "^16.4.5",
    "next": "14.1.3",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.1.3",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "jscpd": "^5.1.1",
    "knip": "^6.34.0",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "sharp": "0.32.6",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
